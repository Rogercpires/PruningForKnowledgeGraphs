PREFIX ex: <http://example.org/ns#>

SELECT ?hour (SUM(?n) AS ?attacks)
WHERE {
    ?aggregate a ex:AggregatedFlow ;
               ex:bucketStart ?timestamp ;
               ex:hasLabelCount ?labelCount .

    ?labelCount a ex:LabelCount ;
                ex:label ?label ;
                ex:count ?n .

    FILTER(?label != "BENIGN")

    BIND(SUBSTR(STR(?timestamp), 1, 13) AS ?hour)
}
GROUP BY ?hour
ORDER BY ?hour
